APP_NAME=Nexyra CRM Business
APP_VERSION=1.1.0-business.1
ENVIRONMENT=development
DEPLOYMENT_MODE=business
API_PREFIX=/api/v1

# PostgreSQL central. Ajuste usuário/senha/host.
DATABASE_URL=postgresql+psycopg://nexyra:troque-a-senha@127.0.0.1:5432/nexyra_business
DATABASE_REQUIRE_POSTGRESQL=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
SQL_ECHO=false

# Desenvolvimento web. Em produção, use seu domínio HTTPS.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
SECURITY_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SECURITY_RATE_LIMIT_ENABLED=false
SECURITY_REQUIRE_STRONG_SECRETS_IN_PRODUCTION=true
SECURITY_DISABLE_DOCS_IN_PRODUCTION=true
SECURITY_HSTS_ENABLED=false

AUTH_SESSION_HOURS=12
AUTH_PASSWORD_ITERATIONS=600000
AUTH_SESSION_TOUCH_MINUTES=5
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_PASSWORD_RESET_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_DELIVERY=console
AUTH_PASSWORD_RESET_FRONTEND_URL=http://127.0.0.1:8080/reset-password

# Troque antes de produção.
INTEGRATION_SECRET_MASTER_KEY=troque-por-segredo-longo-aleatorio
ATLAS_INTEGRATION_TOKEN=troque-se-nao-usar-atlas-desabilite-a-integracao

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_HTTP_TIMEOUT_SECONDS=10

WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_HTTP_TIMEOUT_SECONDS=10
